{
  "name": "bashlab-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/runner.integration.js",
    "runner:start": "bash scripts/start-runner.sh",
    "benchmark": "node tests/benchmark.js",
    "report": "node benchmarks/show_dashboard.js",
    "bench:show": "node benchmarks/show_dashboard.js",
    "db:run": "node scripts/run-sql.mjs",
    "start:api": "node --env-file=.env src/server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "p-limit": "^6.2.0"
  },
  "devDependencies": {
    "pg": "^8.23.0"
  }
}
