# Copy to .env and fill with real values from Supabase Project Settings > API.
# Never commit .env — only this example file with fake values.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=changeme
SUPABASE_ANON_KEY=changeme

# Direct Postgres connection string, used only for running migrations locally.
DATABASE_URL=postgresql://postgres:changeme@db.your-project.supabase.co:5432/postgres

# Existing sandbox runner config (unchanged)
WORKSPACE_ROOT=/var/tmp/bashlab/workspaces
RATE_LIMIT_MAX=30
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
