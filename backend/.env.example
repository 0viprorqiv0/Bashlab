# Copy to .env and fill with real values from Supabase Project Settings > API.
# Never commit .env — only this example file with fake values.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=changeme
SUPABASE_ANON_KEY=changeme

# Direct Postgres connection string, used only for running migrations locally.
DATABASE_URL=postgresql://postgres:changeme@db.your-project.supabase.co:5432/postgres

# Existing sandbox runner config (unchanged)
WORKSPACE_ROOT=/var/tmp/bashlab/workspaces
RATE_LIMIT_MAX=30
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to false on machines without Docker/Linux (e.g. Windows dev): serves only the
# auth API (/api/auth/*); sandbox endpoints answer 503.
SANDBOX_ENABLED=true
SANDBOX_MAX_SESSIONS_PER_USER=3
# Auth API rate limits are built in (see src/routes/auth.js); RATE_LIMIT_MAX above
# only limits sandbox endpoints.

# Admin Activity dashboard (Overview tab): where the API reads time series from.
PROMETHEUS_URL=http://localhost:9090
# Protects /metrics. REQUIRED outside local development; Prometheus sends it as a bearer token.
# METRICS_TOKEN=change-me-long-random

# Maximum concurrent durable sandbox leases across learners
SANDBOX_MAX_ACTIVE_LEASES=100
