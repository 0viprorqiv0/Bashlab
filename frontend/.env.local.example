NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=changeme

# Server-side proxy target for backend API (login, profile, sandbox).
# Browser requests stay on the frontend origin; set this to the backend URL
# reachable from the Next.js server. If both apps run in WSL, use localhost.
API_PROXY_TARGET=http://127.0.0.1:3001

# Optional: adds an Open Grafana button to the admin Activity page.
# NEXT_PUBLIC_GRAFANA_URL=http://localhost:3002
